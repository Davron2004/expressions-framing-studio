# PostgreSQL is required for checkout, webhook processing, and order history.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/framing_studio
# This public demo accepts test-mode Stripe credentials only (sk_test_ or rk_test_).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Public HTTPS origin. http://localhost:3000 is allowed during local development.
APP_URL=http://localhost:3000
